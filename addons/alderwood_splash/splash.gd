# Alderwood studio splash screen ("Bright pop" design, v1.1.0).
# Self-contained: no autoloads, no game-specific dependencies. Godot 4.3+.
# Source of truth: https://github.com/andriiolshevskyi7-hash/alderwood-splash
# Do not edit this file inside a game - change it in the alderwood-splash repo.
extends Control

## Scene to open after the splash finishes (or is skipped by a tap).
@export_file("*.tscn", "*.scn") var next_scene: String = "res://main.tscn"

const WORD := "Alderwood"
const FONT_PATH := "res://addons/alderwood_splash/fonts/Baloo2-Variable.ttf"
const FONT_WEIGHT := 800           # Baloo 2 ExtraBold (variable font axis).
const TEXT_COLOR := Color("#1A1A1A")

# Sizes relative to the screen width. Pixel values from the design are given for
# a 390 px wide screen and scaled by `_unit` (= width / 390).
const TEXT_WIDTH_RATIO := 0.14     # font size = 14% of width (~56 px at 390).
const LEAF_WIDTH_RATIO := 0.14     # leaf width = 14% of width, aspect 54x64.
const LEAF_ASPECT := 64.0 / 54.0
const LEAF_OVERLAP := 6.0          # leaf bottom overlaps the text top (px @390).
const LEAF_PIVOT := Vector2(27.0 / 54.0, 60.0 / 64.0)  # base of the stem.
const ASCENDER_RATIO := 0.661      # height of "l"/"d" in Baloo 2 @800 / em.

# Animation timing (seconds). Total ~2.4 s.
const LETTER_STAGGER := 0.05
const LETTER_RISE := 0.20          # from below -> overshoot above.
const LETTER_LAND := 0.12          # overshoot -> squash on the spot.
const LETTER_SETTLE := 0.13        # squash -> rest.
const LETTER_FROM_Y := 60.0        # px @390
const LETTER_OVERSHOOT_Y := -14.0  # px @390
const LEAF_START := 0.70           # while the last letters are landing.
const LEAF_POP := 0.25
const LEAF_SETTLE := 0.15
const HOLD := 0.9
const FADE_OUT := 0.35

@onready var _content: Control = $Content
@onready var _wordmark: Control = $Content/Wordmark
@onready var _leaf_anchor: Control = $Content/LeafAnchor
@onready var _leaf: TextureRect = $Content/LeafAnchor/Leaf

var _font: FontVariation
var _letters: Array[Label] = []
var _unit := 1.0
var _tween: Tween
var _leaving := false


func _ready() -> void:
	_font = FontVariation.new()
	_font.base_font = load(FONT_PATH)
	var wght_tag := TextServerManager.get_primary_interface().name_to_tag("wght")
	_font.variation_opentype = {wght_tag: FONT_WEIGHT}

	for ch in WORD:
		var slot := Control.new()
		slot.mouse_filter = Control.MOUSE_FILTER_IGNORE
		var label := Label.new()
		label.text = ch
		label.mouse_filter = Control.MOUSE_FILTER_IGNORE
		label.add_theme_font_override("font", _font)
		label.add_theme_color_override("font_color", TEXT_COLOR)
		label.add_theme_constant_override("outline_size", 0)
		slot.add_child(label)
		_wordmark.add_child(slot)
		_letters.append(label)

	resized.connect(_layout)
	_layout()
	_animate()


func _layout() -> void:
	var w := size.x
	var h := size.y
	if w <= 0.0 or h <= 0.0:
		return
	_unit = w / 390.0

	# --- Text metrics -----------------------------------------------------
	var font_size := maxi(1, roundi(w * TEXT_WIDTH_RATIO))
	var text_width := _font.get_string_size(WORD, HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
	var ascent := _font.get_ascent(font_size)
	var line_h := _font.get_height(font_size)
	var glyph_top := float(font_size) * ASCENDER_RATIO  # baseline -> top of "l"

	# --- Leaf -------------------------------------------------------------
	var leaf_w := w * LEAF_WIDTH_RATIO
	var leaf_h := leaf_w * LEAF_ASPECT
	var overlap := LEAF_OVERLAP * _unit

	# Centre the whole group (leaf + visible part of the text) vertically.
	var group_h := leaf_h - overlap + glyph_top
	var group_top := (h - group_h) * 0.5
	var baseline := group_top + leaf_h - overlap + glyph_top

	_leaf_anchor.position = Vector2((w - leaf_w) * 0.5, group_top)
	_leaf_anchor.size = Vector2(leaf_w, leaf_h)
	_leaf.position = Vector2.ZERO
	_leaf.size = Vector2(leaf_w, leaf_h)
	_leaf.pivot_offset = Vector2(leaf_w, leaf_h) * LEAF_PIVOT

	# --- Letters (each in its own slot so it can be animated alone) ------
	var x0 := (w - text_width) * 0.5
	for i in _letters.size():
		var label := _letters[i]
		label.add_theme_font_size_override("font_size", font_size)
		# Prefix widths keep the font's kerning between letters.
		var x := _font.get_string_size(WORD.substr(0, i), HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
		var x_next := _font.get_string_size(WORD.substr(0, i + 1), HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
		var gw := x_next - x
		var slot := label.get_parent() as Control
		slot.position = Vector2(x0 + x, baseline - ascent)
		slot.size = Vector2(gw, line_h)
		label.size = Vector2(gw, line_h)
		# Pivot at the bottom centre of the letter (on the baseline).
		label.pivot_offset = Vector2(gw * 0.5, ascent)


func _animate() -> void:
	_tween = create_tween().set_parallel(true)

	# 1. Letters pop up from below, one after another.
	for i in _letters.size():
		var label := _letters[i]
		var t := i * LETTER_STAGGER
		label.modulate.a = 0.0
		label.position.y = LETTER_FROM_Y * _unit
		label.scale = Vector2(1.0, 0.6)

		_tween.tween_property(label, "modulate:a", 1.0, LETTER_RISE * 0.6).set_delay(t)
		_tween.tween_property(label, "position:y", LETTER_OVERSHOOT_Y * _unit, LETTER_RISE) \
			.set_delay(t).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
		_tween.tween_property(label, "scale", Vector2(1.0, 1.12), LETTER_RISE) \
			.set_delay(t).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

		t += LETTER_RISE
		_tween.tween_property(label, "position:y", 0.0, LETTER_LAND) \
			.set_delay(t).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)
		_tween.tween_property(label, "scale", Vector2(1.0, 0.9), LETTER_LAND) \
			.set_delay(t).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)

		t += LETTER_LAND
		_tween.tween_property(label, "scale", Vector2.ONE, LETTER_SETTLE) \
			.set_delay(t).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

	# 2. Leaf shoots out from its base.
	_leaf.scale = Vector2.ZERO
	_leaf.rotation = deg_to_rad(-40.0)
	_tween.tween_property(_leaf, "scale", Vector2(1.25, 1.25), LEAF_POP) \
		.set_delay(LEAF_START).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	_tween.tween_property(_leaf, "rotation", deg_to_rad(10.0), LEAF_POP) \
		.set_delay(LEAF_START).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	var leaf_t := LEAF_START + LEAF_POP
	_tween.tween_property(_leaf, "scale", Vector2.ONE, LEAF_SETTLE) \
		.set_delay(leaf_t).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)
	_tween.tween_property(_leaf, "rotation", 0.0, LEAF_SETTLE) \
		.set_delay(leaf_t).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN_OUT)

	# 3. Hold, 4. fade everything out over the yellow background, then leave.
	_tween.chain().tween_interval(HOLD)
	_tween.chain().tween_property(_content, "modulate:a", 0.0, FADE_OUT) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	_tween.chain().tween_callback(_go_next)


func _input(event: InputEvent) -> void:
	var tapped := false
	if event is InputEventScreenTouch:
		tapped = (event as InputEventScreenTouch).pressed
	elif event is InputEventMouseButton:
		tapped = (event as InputEventMouseButton).pressed
	else:
		tapped = event.is_action_pressed("ui_accept")
	if tapped:
		get_viewport().set_input_as_handled()
		_go_next()


func _go_next() -> void:
	if _leaving:
		return
	_leaving = true
	if _tween and _tween.is_valid():
		_tween.kill()
	if next_scene.is_empty() or not ResourceLoader.exists(next_scene):
		push_error("Alderwood splash: next_scene not found: '%s'" % next_scene)
		return
	get_tree().call_deferred("change_scene_to_file", next_scene)
